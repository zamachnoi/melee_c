{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "rootDir": "web",
    "outDir": "web/dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["web/**/*.ts"],
  "exclude": ["web/dist"]
}
